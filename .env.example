# Happy Steps — переменные окружения. Таблица с пояснениями: README.md → «Переменные окружения».
# Локально: `npm run db:start` сам пишет .env.local. Vercel: Settings → Environment Variables.
# Свой сервер (docker compose): скопируйте в .env рядом с docker-compose.yml.
# [секрет] — никому не показывать, не коммитить. NEXT_PUBLIC_* видны в браузере и вшиваются при сборке
# (после изменения нужна пересборка: Redeploy в Vercel / `docker compose up -d --build`).

# ── Supabase ──────────────────────────────────────────────────────────────────────────────────────────
# Адрес API Supabase: https://<ref>.supabase.co (Cloud) или https://api.<ваш-домен> (свой сервер).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Публичный anon-ключ (Project Settings → API). Безопасен для браузера: доступ ограничен RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# [секрет] service_role-ключ: обходит RLS, используется только на сервере.
SUPABASE_SERVICE_ROLE_KEY=
# [секрет] Прямое подключение к Postgres — только для тестов и seed-скриптов; приложению в продакшене не нужно.
SUPABASE_DB_URL=postgres://postgres:postgres@127.0.0.1:5432/happysteps

# ── Приложение ────────────────────────────────────────────────────────────────────────────────────────
# Публичный адрес приложения без слеша в конце (ссылки-приглашения, push, QR анкеты).
APP_URL=http://localhost:3000
# Технический домен для входа по телефону (DECISIONS.md D-004): логин = <цифры телефона>@<домен>.
# Пользователи его не видят, письма не отправляются. Задайте один раз и больше не меняйте —
# иначе существующие пользователи не смогут войти.
AUTH_EMAIL_DOMAIN=users.happysteps.local
# [секрет] Общий секрет для /api/cron/* (заголовок "Authorization: Bearer ..."). Сгенерировать: openssl rand -hex 32
CRON_SECRET=

# ── Web Push (VAPID) ──────────────────────────────────────────────────────────────────────────────────
# Пара ключей: npx web-push generate-vapid-keys (локальный стек генерирует свою пару).
# Смена пары отключает все существующие подписки браузеров — пользователям придётся включить push заново.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# [секрет]
VAPID_PRIVATE_KEY=
# Контакт для push-сервисов (mailto: или https:).
VAPID_SUBJECT=mailto:support@example.kz
# Только локально/e2e: разрешить push на 127.0.0.1/localhost (в продакшене не задавать).
# PUSH_ALLOW_LOCAL_ENDPOINTS=1
# Необязательно (при сборке): 0 — выключить service worker/PWA в этой сборке; по умолчанию включён в production.
# NEXT_PUBLIC_ENABLE_SW=0

# ── Сеть ──────────────────────────────────────────────────────────────────────────────────────────────
# Сколько доверенных прокси перед приложением дописывают X-Forwarded-For (по умолчанию 1).
# IP клиента для лимитов берётся на столько звеньев справа. На Vercel не используется
# (берётся x-vercel-forwarded-for). Caddy из docker-compose → 1; Cloudflare + Caddy → 2; 0 — IP неизвестен.
TRUSTED_PROXY_HOPS=1

# ── Только для docker compose (свой сервер, docs/self-hosting.md) ───────────────────────────────────────
# Домен приложения и домен API Supabase — Caddy получит для них HTTPS-сертификаты автоматически.
# APP_DOMAIN=app.example.kz
# API_DOMAIN=api.example.kz
# ACME_EMAIL=admin@example.kz
