# Copy to .env.local (dev) or set in Vercel / your server. Locally `npm run db:start` fills these in.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection — only needed for tests and seed scripts
SUPABASE_DB_URL=postgres://postgres:postgres@127.0.0.1:5432/happysteps
# Public URL of the app (invite links, push)
APP_URL=http://localhost:3000
# Technical e-mail domain for phone logins (DECISIONS.md D-004); never shown to users
AUTH_EMAIL_DOMAIN=users.happysteps.local
# Shared secret for /api/cron/* (Vercel Cron sends it as "Authorization: Bearer ...")
CRON_SECRET=
# Web Push (stage 6): npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@example.kz
